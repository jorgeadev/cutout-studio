{
	"name": "cutout-studio",
	"version": "0.1.0",
	"description": "Privacy-first, on-device AI background remover for batch images with model selection, edge refinement, custom backgrounds, and flexible exports.",
	"private": true,
	"license": "AGPL-3.0-only",
	"keywords": [
		"background-removal",
		"image-processing",
		"image-segmentation",
		"image-matting",
		"onnx",
		"webassembly",
		"webgpu",
		"react",
		"typescript",
		"vite",
		"pwa",
		"privacy",
		"client-side",
		"batch-processing"
	],
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"start": "vite preview",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"audit": "pnpm audit --audit-level=moderate",
		"check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@imgly/background-removal": "1.7.0",
		"@vercel/analytics": "2.0.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"jszip": "3.10.1",
		"lucide-react": "1.27.0",
		"next-themes": "0.4.6",
		"onnxruntime-web": "1.21.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"sonner": "2.0.7",
		"tailwind-merge": "3.6.0",
		"tw-animate-css": "1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.4",
		"@vitest/coverage-v8": "4.1.10",
		"postcss": "8.5.23",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"vitest": "4.1.10"
	}
}
